# ── Gateway ─────────────────────────────────────────────────────────
# Public key clients must send as `Authorization: Bearer <key>`.
PUBLIC_API_KEY="nishan-bajagain"
# Optional: key the built-in playground uses in the browser.
# NEXT_PUBLIC_PUBLIC_API_KEY="nishan-bajagain"

# Rate limiting (requests per minute per key; 0 disables).
RATE_LIMIT_RPM="120"
# Deterministic-response cache (seconds; 0 disables).
CACHE_TTL_SECONDS="60"
CACHE_MAX_ENTRIES="200"
# Telemetry file (defaults to ./data.json).
# DATA_FILE="/data/hamro-data.json"

# ── Telemetry persistence on serverless (Vercel) ─────────────────────
# Vercel instances have an ephemeral read-only filesystem, so file-based
# telemetry resets on every cold start. Two free options keep /status data
# across instances and restarts:
#
# 1) FREE REMOTE JSON (zero setup, no account): the gateway auto-creates a
#    free jsonblob.com blob on first write, remembers it, and self-heals when
#    it expires (~24h rolling window on jsonblob's free tier). Nothing to set
#    here — it just works. For a durable endpoint you control, set:
# REMOTE_JSON_URL="https://jsonblob.com/api/jsonBlob/<id>"
#    (or any JSON endpoint that speaks GET/PUT). Paste a jsonblob.com/<id>
#    viewer URL and it is normalized automatically.
#
# 2) VERCEL KV / Upstash (optional, durable): add a free KV store and set
#    these two vars — telemetry also persists to the shared KV.
# KV_REST_API_URL="https://your-kv.upstash.io"
# KV_REST_API_TOKEN="AUpX..."
#
# Test override (used by scripts/verify-remote.mjs):
# JSONBLOB_API_URL="https://jsonblob.com/api/jsonBlob"

# ── Providers ────────────────────────────────────────────────────────
GROQ_API_KEY="gsk_..."
# GROQ_BASE_URL="https://api.groq.com/openai/v1"

OPENROUTER_API_KEY="sk-or-..."
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

OPENCODE_API_KEY="sk-..."
OPENCODE_BASE_URL="https://opencode.ai/zen/v1"

# Ollama Cloud (free models: nemotron-3-ultra, nemotron-3-super, gpt-oss:120b, gemma4:31b)
OLLAMA_API_KEY="..."
# OLLAMA_BASE_URL="https://ollama.com/v1"

# Naga AI (free models: nemotron-3-ultra-550b-a55b:free, nemotron-3-super-120b-a12b:free, llama-3.3-70b-instruct:free, llama-4-scout-17b-16e-instruct:free)
NAGA_API_KEY="ng-..."
# NAGA_BASE_URL="https://api.naga.ac/v1"

# ZenMux (free models: deepseek/deepseek-v4-flash-free, z-ai/glm-4.7-flash-free, z-ai/glm-4.6v-flash-free)
ZENMUX_API_KEY="sk-mg-v1-..."
# ZENMUX_BASE_URL="https://zenmux.ai/api/v1"

# LLM7 (free turbo tier: gpt-oss:20b, gemma4:31b, minimax-m2.7, codestral-latest, mistral-Nemo-Instruct-2407)
LLM7_API_KEY="..."
# LLM7_BASE_URL="https://api.llm7.io/v1"

# Cerebras
CEREBRAS_API_KEY="csk-..."
# CEREBRAS_BASE_URL="https://api.cerebras.ai/v1"

# Chutes AI
CHUTES_API_KEY="cpk_..."
# CHUTES_BASE_URL="https://llm.chutes.ai/v1"

# HuggingFace Inference Providers router (free models)
HUGGINGFACE_API_KEY="hf_..."
# HUGGINGFACE_BASE_URL="https://router.huggingface.co/v1"

# Optional: comma-separated model overrides per provider (must match provider model ids)
# GROQ_MODELS="llama-3.3-70b-versatile"
# OLLAMA_MODELS="nemotron-3-ultra,gpt-oss:120b"
# NAGA_MODELS="nemotron-3-ultra-550b-a55b:free"
# ZENMUX_MODELS="deepseek/deepseek-v4-flash-free"
# LLM7_MODELS="gpt-oss:20b"
# CEREBRAS_MODELS="zai-glm-4.7"
# CHUTES_MODELS="deepseek-ai/DeepSeek-V4-Flash-0731-TEE"
# HUGGINGFACE_MODELS="meta-llama/Llama-3.3-70B-Instruct"

# ── Fallback chain ───────────────────────────────────────────────────
# Ordered provider/model list tried when a requested model fails.
MODEL_FALLBACK_CHAIN="groq/llama-3.3-70b-versatile,ollama/nemotron-3-ultra,naga/nemotron-3-ultra-550b-a55b:free,llm7/gpt-oss:20b,huggingface/meta-llama/Llama-3.3-70B-Instruct,openrouter/nvidia/nemotron-3-ultra-550b-a55b:free,zenmux/deepseek/deepseek-v4-flash-free,cerebras/zai-glm-4.7,chutes/deepseek-ai/DeepSeek-V4-Flash-0731-TEE,opencode/nemotron-3-ultra-free,opencode/deepseek-v4-flash-free"

# ── Sticky random model ──────────────────────────────────────────────
# How long a session keeps its randomly-picked model after last use (seconds).
RANDOM_SESSION_TTL_SECONDS="3600"
